#!/usr/bin/env bash
set -e
set -u
set -o pipefail

if hash pbpaste 2>/dev/null; then
  exec pbpaste
elif [[ -n "${WAYLAND_DISPLAY:-}" ]] && hash wl-paste 2>/dev/null; then
  exec wl-paste
elif [[ -n "${DISPLAY:-}" ]] && hash xclip 2>/dev/null; then
  exec xclip -selection clipboard -o
else
  echo 'cannot find a paste program' >&2
  exit 1
fi
