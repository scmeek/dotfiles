#!/usr/bin/env bash
set -e
set -u

RFKILL=(sudo /usr/sbin/rfkill)

wifi_interface() {
  networksetup -listallhardwareports | awk '/Hardware Port: (Wi-Fi|AirPort)/ {getline; sub(/^Device: /, ""); print; exit}'
}

is_wifi_enabled() {
  local result interface
  if [[ "$(uname)" == 'Darwin' ]]; then
    interface="$(wifi_interface)"
    [[ -n "$interface" ]] || {
      echo "Wi-Fi interface not found" >&2
      return 1
    }
    result="$(networksetup -getairportpower "$interface")"
    if [[ "$result" == *": Off" ]]; then
      echo 'false'
    else
      echo 'true'
    fi
  else
    echo 'not supported yet'
    exit 1
  fi
}

make_sure_wifi_is_enabled() {
  if [[ "$(is_wifi_enabled)" == 'false' ]]; then
    echo 'wifi is disabled; cannot perform this operation'
    exit 1
  fi
}

wifi_list() {
  if [[ "$(uname)" == 'Darwin' ]]; then
    local interface
    interface="$(wifi_interface)"
    [[ -n "$interface" ]] || {
      echo "Wi-Fi interface not found" >&2
      return 1
    }
    networksetup -listpreferredwirelessnetworks "$interface"
  else
    echo 'not supported yet'
    exit 1
  fi
}

wifi_join() {
  if [[ "$(uname)" == 'Darwin' ]]; then
    local interface
    interface="$(wifi_interface)"
    [[ -n "$interface" ]] || {
      echo "Wi-Fi interface not found" >&2
      return 1
    }
    networksetup -setairportnetwork "$interface" "$1" "$2"
  else
    echo 'not supported yet'
    exit 1
  fi
}

wifi_off() {
  if [[ "$(uname)" == 'Darwin' ]]; then
    local interface
    interface="$(wifi_interface)"
    [[ -n "$interface" ]] || {
      echo "Wi-Fi interface not found" >&2
      return 1
    }
    networksetup -setairportpower "$interface" off
  else
    "${RFKILL[@]}" block wifi
  fi
}

wifi_on() {
  if [[ "$(uname)" == 'Darwin' ]]; then
    local interface
    interface="$(wifi_interface)"
    [[ -n "$interface" ]] || {
      echo "Wi-Fi interface not found" >&2
      return 1
    }
    networksetup -setairportpower "$interface" on
  else
    "${RFKILL[@]}" unblock wifi
  fi
}

wifi_toggle() {
  if [[ "$(uname)" == 'Darwin' ]]; then
    wifi_off
    sleep 1
    wifi_on
  else
    sudo systemctl restart wpa_supplicant
  fi
}

help() {
  echo 'wifi status                       print wifi status'
  echo 'wifi list                         list networks'
  echo 'wifi join SSID PASSWORD   join a network'
  echo 'wifi off                          turn off wifi'
  echo 'wifi on                           turn on wifi'
  echo 'wifi toggle                       turn off wifi, then on'
  echo 'wifi help                         show this message'
}

if [[ $# == 0 ]]; then
  help
  exit 0
elif [[ "$1" == 'help' ]]; then
  help
  exit 0
elif [[ "$1" == 'status' ]]; then
  if [[ "$(is_wifi_enabled)" == 'true' ]]; then
    echo 'wifi is enabled'
    echo 'not sure how to parse the rest yet'
  else
    echo 'wifi is disabled'
  fi
elif [[ "$1" == 'list' ]]; then
  make_sure_wifi_is_enabled
  wifi_list
elif [[ "$1" == 'join' ]]; then
  if [[ $# -ne 3 ]]; then
    echo 'usage: wifi join SSID PASSWORD' >&2
    exit 2
  fi
  make_sure_wifi_is_enabled
  wifi_join "$2" "$3"
elif [[ "$1" == 'off' ]]; then
  wifi_off
elif [[ "$1" == 'on' ]]; then
  wifi_on
elif [[ "$1" == 'toggle' ]]; then
  wifi_toggle
else
  echo "I don't know about that command"
  exit 1
fi
