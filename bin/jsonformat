#!/usr/bin/env bash
set -e
set -u
set -o pipefail

if hash node 2>/dev/null; then
  node -e '
  process.stdin.setEncoding("utf8")

  let jsonString = ""

  process.stdin.on("readable", () => {
    const chunk = process.stdin.read()
    if (chunk) {
      jsonString += chunk
    }
  })

  process.stdin.on("end", () => {
    try {
      console.log(JSON.stringify(JSON.parse(jsonString), null, 2))
    } catch (error) {
      console.error("jsonformat: " + error.message)
      process.exitCode = 1
    }
  })
  '
elif hash jq 2>/dev/null; then
  jq --monochrome-output --slurp 'if length == 1 then .[0] else error("expected one JSON document") end'
else
  echo 'jsonformat: node or jq is required' >&2
  exit 1
fi
