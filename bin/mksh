#!/usr/bin/env bash

set -euo pipefail

if [ ! $# -eq 1 ]; then
  echo 'mksh takes one argument' 1>&2
  exit 1
elif [ -e "$1" ]; then
  echo "$1 already exists" 1>&2
  exit 1
fi

cat >"$1" <<'EOF'
#!/usr/bin/env bash

set -euo pipefail

main() {
    for arg in "$@"; do
        echo "$arg"
    done

    echo "Hello, world!"
}

main "$@"
EOF

chmod u+x "$1"

"$EDITOR" "$1"
